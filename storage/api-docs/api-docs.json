{
    "openapi": "3.0.0",
    "info": {
        "title": "My API",
        "description": "Backend API for developer landing page",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://my-api.local",
            "description": "Local server"
        }
    ],
    "paths": {
        "/api/v1/contact": {
            "post": {
                "tags": [
                    "Contact"
                ],
                "summary": "Create contact request",
                "operationId": "869994463d56ca59fb1095ac89a45e84",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name",
                                    "email",
                                    "comment"
                                ],
                                "properties": {
                                    "name": {
                                        "description": "User name",
                                        "type": "string",
                                        "example": "Александр"
                                    },
                                    "phone": {
                                        "description": "Phone number",
                                        "type": "string",
                                        "example": "+79999999999"
                                    },
                                    "email": {
                                        "description": "User email",
                                        "type": "string",
                                        "example": "test@example.com"
                                    },
                                    "comment": {
                                        "description": "Message text",
                                        "type": "string",
                                        "example": "Хочу заказать разработку сайта"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Contact created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ContactResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/ValidationErrorResponse"
                                }
                            }
                        }
                    },
                    "429": {
                        "description": "Too many requests",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/RateLimitErrorResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/api/v1/health": {
            "get": {
                "tags": [
                    "System"
                ],
                "summary": "API health check",
                "operationId": "75aa2f24b75e1cb18ac69fb7ff10bc7b",
                "responses": {
                    "200": {
                        "description": "Successful response"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "ContactResponse": {
                "properties": {
                    "success": {
                        "type": "boolean",
                        "example": true
                    },
                    "message": {
                        "type": "string",
                        "example": "Contact request created"
                    },
                    "data": {
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "RateLimitErrorResponse": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Too many requests from this email"
                    }
                },
                "type": "object"
            },
            "ValidationErrorResponse": {
                "properties": {
                    "message": {
                        "type": "string",
                        "example": "Validation failed"
                    },
                    "errors": {
                        "type": "object",
                        "example": {
                            "name": [
                                "Имя обязательно для заполнения"
                            ],
                            "email": [
                                "Некорректный формат email"
                            ],
                            "comment": [
                                "Комментарий обязателен"
                            ]
                        }
                    }
                },
                "type": "object"
            }
        }
    },
    "tags": [
        {
            "name": "Contact",
            "description": "Contact"
        },
        {
            "name": "System",
            "description": "System"
        }
    ]
}